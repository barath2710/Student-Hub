# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/studenthub

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_refresh_secret_key_change_this_in_production
JWT_REFRESH_EXPIRE=30d

# Comma-separated list of allowed frontend origins.
# Dev: include all Vite dev ports you use (auto-allowed in development anyway).
# Prod: set to your real deployed URL, e.g. https://studenthub.example.com
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175

# ─── Email (optional – for notifications) ────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_mailtrap_user
SMTP_PASS=your_mailtrap_password
FROM_EMAIL=noreply@studenthub.com
FROM_NAME=StudentHub

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
